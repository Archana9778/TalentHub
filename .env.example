# TalentHub Docker & Application Environment Configuration
# Copy this file to .env and adjust variables as needed for local Docker Compose or production deployments.
# NEVER commit the actual .env file with secrets to source control.

# ─── Application & Ports ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
API_HOST_PORT=5000
FRONTEND_PORT=5173
FRONTEND_HTTP_PORT=80
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost,http://127.0.0.1:5173

# ─── MySQL Database ────────────────────────────────────────────────────────────
DB_MODE=mysql
DB_DRIVER=mysql2
DB_HOST=database
DB_PORT=3306
DB_HOST_PORT=3308
DB_NAME=talenthub
DB_USER=talenthub_user
DB_PASSWORD=root123
MYSQL_DATABASE=talenthub
MYSQL_USER=talenthub_user
MYSQL_PASSWORD=root123
MYSQL_ROOT_PASSWORD=change-this-local-root-password
DB_SSL=false

# ─── Security & Authentication ────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
PASSWORD_RESET_EXPIRES_MINUTES=15

# ─── Azure Blob Storage / Azurite Emulator ────────────────────────────────────
# STORAGE_PROVIDER: 'azurite' (local emulator) | 'azure' (production Managed Identity)
STORAGE_PROVIDER=azurite
AZURE_STORAGE_ACCOUNT_NAME=devstoreaccount1
AZURE_STORAGE_CONTAINER_NAME=talenthub-resumes
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
RESUME_MAX_FILE_SIZE_MB=10
MAX_RESUME_SIZE_MB=10
AZURE_STORAGE_SAS_EXPIRY_MINUTES=15
RESUME_SAS_EXPIRY_MINUTES=15

# ─── SMTP Email Configuration (Password Reset Delivery) ───────────────────────
# Optional for local development; required for real outbound email in production
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TalentHub Security <no-reply@talenthub.com>
SMTP_SECURE=false
