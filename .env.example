DB_NAME=talenthub
DB_USER=talenthub_user
DB_PASSWORD=change-this-local-database-password
MYSQL_ROOT_PASSWORD=change-this-local-root-password
DB_PORT=3306
DB_HOST_PORT=3306
API_HOST_PORT=5000
FRONTEND_HTTP_PORT=80
FRONTEND_ALT_PORT=5173
DB_SSL=false
DB_MODE=mysql
JWT_SECRET=change-this-to-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost,http://localhost:5173
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRES_MINUTES=15

# SMTP Email Configuration (Password Reset Delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TalentHub Security <no-reply@talenthub.com>
SMTP_SECURE=false
