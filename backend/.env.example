# TalentHub Node.js Backend Environment Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=change-this-to-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRES_MINUTES=15
DB_MODE=mysql

# MySQL 8.0 / Azure Database for MySQL Flexible Server
DB_HOST=localhost
DB_PORT=3306
DB_USER=talenthub_user
DB_PASSWORD=change-this-local-database-password
DB_NAME=talenthub
DB_CONNECTION_LIMIT=10
# Set DB_SSL=true when connecting to Azure Database for MySQL Flexible Server
DB_SSL=false

# SMTP Email Configuration (Password Reset Delivery)
# Configure with SendGrid, AWS SES, Mailgun, Mailpit, or enterprise SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TalentHub Security <no-reply@talenthub.com>
SMTP_SECURE=false
