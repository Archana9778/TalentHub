# TalentHub Backend Environment Configuration
# Copy this file to .env and configure your local or Azure MySQL credentials.

# Application Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Security & Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Database Configuration (MySQL 8.0 / Azure Database for MySQL Flexible Server)
DB_DRIVER=mysql2
DB_HOST=localhost
DB_PORT=3308
DB_NAME=talenthub
DB_USER=talenthub_user
DB_PASSWORD=replace-with-your-database-password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Azure AI Document Intelligence (Optional - Heuristic regex parser fallback used if empty)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
