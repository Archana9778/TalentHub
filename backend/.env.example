# TalentHub Node.js Backend Environment Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=change-this-to-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
DB_MODE=mysql

# MySQL 8.0 / Azure Database for MySQL Flexible Server
DB_HOST=localhost
DB_PORT=3306
DB_USER=talenthub_user
DB_PASSWORD=change-this-local-database-password
DB_NAME=talenthub
DB_CONNECTION_LIMIT=10
# Set DB_SSL=true when connecting to Azure Database for MySQL Flexible Server
DB_SSL=false

# Azure Blob Storage (Use 'azurite' for local emulator, 'azure' for Azure Cloud)
STORAGE_PROVIDER=azurite
# For local Azurite development:
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1
AZURE_STORAGE_ACCOUNT_NAME=devstoreaccount1
AZURE_STORAGE_CONTAINER_NAME=talenthub-resumes
RESUME_MAX_FILE_SIZE_MB=10
AZURE_STORAGE_SAS_EXPIRY_MINUTES=15


