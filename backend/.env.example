# TalentHub Backend Environment Configuration
# Copy this file to .env and fill in your local or Azure credentials.
# NEVER commit the actual .env file to source control.

# ─── Application Server ───────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ─── Security & Authentication ────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
PASSWORD_RESET_EXPIRES_MINUTES=15

# ─── Database Configuration (MySQL 8.0 / Azure Database for MySQL Flexible Server / JSON) ──
# DB_MODE: 'mysql' (production & default) | 'json' (development/test opt-in)
DB_MODE=json
DB_DRIVER=mysql2
DB_HOST=localhost
DB_PORT=3306
DB_NAME=talenthub
DB_USER=talenthub_user
DB_PASSWORD=replace-with-your-database-password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_LIMIT=10

# ─── SMTP Email Configuration (Password Reset Delivery) ───────────────────────
# Configure with SendGrid, AWS SES, Mailgun, Mailpit, or enterprise SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TalentHub Security <no-reply@talenthub.com>
SMTP_SECURE=false

# ─── Azure Blob Storage ───────────────────────────────────────────────────────
# STORAGE_PROVIDER: 'azurite' (local emulator) | 'azure' (production Managed Identity)
STORAGE_PROVIDER=azurite

# Azurite local development connection string (well-known public emulator credentials):
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1

# Azure production: set STORAGE_PROVIDER=azure and provide your real account name.
# The backend uses DefaultAzureCredential (Managed Identity / Azure CLI / environment).
# Do NOT set AZURE_STORAGE_CONNECTION_STRING for production — use Managed Identity instead.
AZURE_STORAGE_ACCOUNT_NAME=devstoreaccount1

# Private blob container name (created automatically on first upload)
AZURE_STORAGE_CONTAINER_NAME=talenthub-resumes

# Resume file size limit in MB (default 10)
RESUME_MAX_FILE_SIZE_MB=10
MAX_RESUME_SIZE_MB=10

# Short-lived SAS URL expiry in minutes (default 15)
AZURE_STORAGE_SAS_EXPIRY_MINUTES=15
RESUME_SAS_EXPIRY_MINUTES=15

# ─── Azure AI Document Intelligence (optional) ────────────────────────────────
# If not set, a built-in heuristic parser is used instead.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
